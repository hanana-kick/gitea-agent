{{template "admin/layout_head" (dict "pageClass" "admin agent")}}
	<div class="admin-setting-content">
		<h4 class="ui top attached header">
			{{ctx.Locale.Tr "agent.api_keys_title"}} ({{ctx.Locale.Tr "admin.total" .Total}})
			<div class="ui right">
				<a class="ui primary tiny button" href="{{AppSubUrl}}/-/admin/agent/keys/new">{{ctx.Locale.Tr "agent.api_key_add"}}</a>
			</div>
		</h4>
		<div class="ui attached segment">
			<form class="ui form ignore-dirty flex-text-block">
				<div class="tw-flex-1">
					{{template "shared/search/combo" dict "Value" .Keyword "Placeholder" (ctx.Locale.Tr "agent.api_key_search_placeholder")}}
				</div>
			</form>
		</div>
		<div class="ui attached table segment">
			<table class="ui very basic selectable table unstackable">
				<thead>
					<tr>
						<th>{{ctx.Locale.Tr "agent.api_key_name"}}</th>
						<th>{{ctx.Locale.Tr "agent.api_key_used_by"}}</th>
						<th>{{ctx.Locale.Tr "agent.api_key_last_used"}}</th>
						<th>{{ctx.Locale.Tr "agent.api_key_created"}}</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					{{range .APIKeys}}
						<tr>
							<td class="gt-ellipsis tw-max-w-48">{{.Name}}</td>
							<td class="gt-ellipsis tw-max-w-48">
								{{range $i, $provider := index $.Usage .ID}}{{if $i}}, {{end}}{{$provider}}{{else}}—{{end}}
							</td>
							<td class="tw-whitespace-nowrap">
								{{if .LastUsedUnix}}{{DateUtils.TimeSince .LastUsedUnix}}{{else}}{{ctx.Locale.Tr "agent.api_key_never_used"}}{{end}}
							</td>
							<td class="tw-whitespace-nowrap">{{DateUtils.AbsoluteShort .CreatedUnix}}</td>
							<td>
								<div class="tw-flex tw-gap-2">
									<a href="{{AppSubUrl}}/-/admin/agent/keys/{{.ID}}" data-tooltip-content="{{ctx.Locale.Tr "agent.api_key_edit"}}">{{svg "octicon-pencil"}}</a>
									<button type="button" class="btn interact-fg tw-text-red link-action"
										data-url="{{AppSubUrl}}/-/admin/agent/keys/{{.ID}}/delete"
										data-modal-confirm-header="{{ctx.Locale.Tr "agent.delete"}}"
										data-modal-confirm-content="{{ctx.Locale.Tr "agent.api_key_delete_confirm" .Name}}"
										data-tooltip-content="{{ctx.Locale.Tr "agent.delete"}}"
									>{{svg "octicon-trash"}}</button>
								</div>
							</td>
						</tr>
					{{else}}
						<tr><td class="tw-text-center" colspan="5">{{ctx.Locale.Tr "no_results_found"}}</td></tr>
					{{end}}
				</tbody>
			</table>
		</div>

		{{template "base/paginate" .}}
	</div>
{{template "admin/layout_footer" .}}
