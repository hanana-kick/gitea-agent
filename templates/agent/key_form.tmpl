{{template "admin/layout_head" (dict "pageClass" "admin agent")}}
	<div class="admin-setting-content">
		<h4 class="ui top attached header">{{if .IsEdit}}{{ctx.Locale.Tr "agent.api_key_edit"}}{{else}}{{ctx.Locale.Tr "agent.api_key_add"}}{{end}}</h4>
		<div class="ui attached segment">
			<form class="ui form ignore-dirty" method="post" action="{{.FormAction}}">
				{{if .IsEdit}}
					<div class="field">
						<label>{{ctx.Locale.Tr "agent.api_key_name"}}</label>
						<input value="{{.APIKey.Name}}" readonly>
					</div>
				{{else}}
					<div class="required field">
						<label for="name">{{ctx.Locale.Tr "agent.api_key_name"}}</label>
						<input id="name" name="name" maxlength="100" required autofocus placeholder="{{ctx.Locale.TrString "agent.api_key_name_placeholder"}}">
					</div>
				{{end}}
				<div class="required field">
					<label for="value">{{if .IsEdit}}{{ctx.Locale.Tr "agent.api_key_new_value"}}{{else}}{{ctx.Locale.Tr "agent.api_key_value"}}{{end}}</label>
					<input id="value" name="value" type="password" autocomplete="new-password" required{{if not .IsEdit}} autofocus{{end}} placeholder="{{ctx.Locale.TrString "agent.api_key_new_value_placeholder"}}">
					<p class="help">{{if .IsEdit}}{{ctx.Locale.Tr "agent.api_key_edit_help"}}{{else}}{{ctx.Locale.Tr "agent.api_key_value_help"}}{{end}}</p>
				</div>
				<div class="field">
					<button class="ui primary button" type="submit">{{ctx.Locale.Tr "save"}}</button>
					<a class="ui button" href="{{.CancelLink}}">{{ctx.Locale.Tr "cancel"}}</a>
				</div>
			</form>
		</div>
	</div>
{{template "admin/layout_footer" .}}
