{{/* the message composer of the agent chat: the text, the files and the send button.
	A draft (a conversation that does not exist yet) posts to data-draft-url and follows
	the created conversation; an open conversation posts to its messages URL. */}}
{{if .IsDraft}}
	<form class="ui form agent-chat-composer agent-chat-draft" method="post" enctype="multipart/form-data" action="{{AppSubUrl}}/-/agent/new" data-draft-url="{{AppSubUrl}}/-/agent/new">
		<div class="agent-chat-attach-list tw-hidden"></div>
		<input type="hidden" name="kind" value="{{.DraftKind}}">
		{{if .Repo}}<input type="hidden" name="repo_id" value="{{.Repo.ID}}">{{end}}
		<textarea name="content" class="agent-chat-input" rows="3" required placeholder="{{ctx.Locale.Tr "agent.chat_placeholder"}}"{{if not .CanAnswer}} disabled{{end}}></textarea>
		<label class="agent-chat-attach" data-tooltip-content="{{ctx.Locale.Tr "agent.chat_attach"}}">
			{{svg "octicon-paperclip" 16}}
			<input type="file" name="files" multiple>
		</label>
		<button type="submit" class="ui primary button"{{if not .CanAnswer}} disabled{{end}}>{{ctx.Locale.Tr "agent.chat_send"}}</button>
	</form>
{{else}}
	<form class="ui form agent-chat-composer" method="post" enctype="multipart/form-data" action="{{AppSubUrl}}/-/agent/{{.Session.ID}}/messages">
		<div class="agent-chat-attach-list tw-hidden"></div>
		<textarea name="content" class="agent-chat-input" rows="3" required placeholder="{{ctx.Locale.Tr "agent.chat_placeholder"}}"{{if not .CanAnswer}} disabled{{end}}></textarea>
		<label class="agent-chat-attach" data-tooltip-content="{{ctx.Locale.Tr "agent.chat_attach"}}">
			{{svg "octicon-paperclip" 16}}
			<input type="file" name="files" multiple>
		</label>
		<button type="submit" class="ui primary button agent-chat-send"{{if not .CanAnswer}} disabled{{end}}
			data-idle-label="{{ctx.Locale.Tr "agent.chat_send"}}" data-busy-label="{{ctx.Locale.Tr "agent.chat_cancel"}}"
			{{if .RunActive}}data-busy{{end}}>{{if .RunActive}}{{ctx.Locale.Tr "agent.chat_cancel"}}{{else}}{{ctx.Locale.Tr "agent.chat_send"}}{{end}}</button>
	</form>
{{end}}
{{if not .CanAnswer}}
	<p class="agent-chat-hint agent-chat-hint-block">{{ctx.Locale.Tr "agent.chat_model_required"}}</p>
{{end}}
