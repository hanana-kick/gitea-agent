{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content agent-chat-page{{if or .Session .IsDraft}} has-panel{{end}}">
	{{template "base/alert" ctx.RootData}}
	<div class="ui container fluid padded flex-container agent-chat" data-runs-url="{{AppSubUrl}}/-/agent/events" data-busy-label="{{ctx.Locale.Tr "agent.chat_busy"}}" data-attach-remove-label="{{ctx.Locale.Tr "agent.chat_attach_remove"}}" data-attach-more-label="{{ctx.Locale.Tr "agent.chat_more"}}">
		<div class="flex-container-nav agent-chat-nav" aria-label="{{ctx.Locale.Tr "agent.chat_sessions"}}">
			{{template "agent/chat_list" .}}
		</div>
		{{template "agent/chat_ui" .}}
	</div>
	{{template "agent/chat_modals" .}}
</div>
{{template "base/footer" .}}
