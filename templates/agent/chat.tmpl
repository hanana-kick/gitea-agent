{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content agent-chat-page{{if or .Session .IsDraft}} has-panel{{end}}">
	{{template "base/alert" ctx.RootData}}
	<div class="ui container fluid padded flex-container agent-chat" data-runs-url="{{AppSubUrl}}/-/agent/events" data-busy-label="{{ctx.Locale.Tr "agent.chat_busy"}}" data-attach-remove-label="{{ctx.Locale.Tr "agent.chat_attach_remove"}}" data-attach-more-label="{{ctx.Locale.Tr "agent.chat_more"}}">
		<div class="flex-container-nav agent-chat-nav" aria-label="{{ctx.Locale.Tr "agent.chat_sessions"}}">
			{{template "agent/chat_list" .}}
		</div>
		<div class="flex-container-main agent-chat-main" aria-label="{{ctx.Locale.Tr "agent.chat_title"}}"
			{{if .Session}}data-conversation-id="{{.Session.ID}}"
			data-last-message-id="{{.LastMessageID}}"
			data-events-url="{{AppSubUrl}}/-/agent/{{.Session.ID}}/events"
			data-messages-url="{{AppSubUrl}}/-/agent/{{.Session.ID}}/messages"
			data-cancel-url="{{AppSubUrl}}/-/agent/{{.Session.ID}}/cancel"
			data-approvals-url="{{AppSubUrl}}/-/agent/{{.Session.ID}}/approvals"
			data-run-id="{{.PendingRunID}}"
			data-approval-title="{{ctx.Locale.Tr "agent.chat_approval_title" "%s"}}"
			data-approval-help="{{ctx.Locale.Tr "agent.chat_approval_help"}}"
			data-approval-allow="{{ctx.Locale.Tr "agent.chat_approval_allow"}}"
			data-approval-refuse="{{ctx.Locale.Tr "agent.chat_approval_refuse"}}"
			data-labels="{{.LabelsJSON}}"{{end}}>
			{{if .IsDraft}}
				{{template "agent/chat_draft" .}}
			{{else if .Session}}
				{{template "agent/chat_panel" .}}
			{{else}}
				<div class="agent-chat-empty-main">
					{{svg "gitea-pod-outline" 56}}
					<p class="agent-chat-empty-title">{{ctx.Locale.Tr "agent.chat_select_session"}}</p>
					<p class="agent-chat-hint">{{ctx.Locale.Tr "agent.chat_select_session_help"}}</p>
				</div>
			{{end}}
		</div>
	</div>
	{{template "agent/chat_modals" .}}
</div>
{{template "base/footer" .}}
