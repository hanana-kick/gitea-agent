{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content agent-chat-page{{if .Session}} has-session{{end}}">
	{{template "base/alert" ctx.RootData}}
	<div class="ui container fluid padded flex-container agent-chat">
		<div class="flex-container-nav agent-chat-nav" aria-label="{{ctx.Locale.Tr "agent.chat_sessions"}}">
			<div class="ui two item menu agent-chat-tabs">
				<a class="item{{if eq .Scope "pod"}} active{{end}}" href="{{.ScopeBaseURL}}?scope=pod">{{ctx.Locale.Tr "agent.chat_tab_pod"}}</a>
				<a class="item{{if eq .Scope "repository"}} active{{end}}" href="{{.ScopeBaseURL}}?scope=repository">{{ctx.Locale.Tr "agent.chat_tab_repository"}}</a>
			</div>

			{{if eq .Scope "pod"}}
				<h4 class="ui top attached header tw-flex tw-items-center">
					<div class="tw-flex-1 tw-flex tw-items-center">
						{{ctx.Locale.Tr "agent.chat_resident"}}
						<span class="ui grey label tw-ml-2">{{index .ScopeCounts "pod"}}</span>
					</div>
				</h4>
				<form class="ui attached segment agent-chat-search" method="get" action="{{.ScopeBaseURL}}">
					<input type="hidden" name="scope" value="pod">
					<div class="ui small fluid left icon input">
						<input type="search" name="q" value="{{.Keyword}}" spellcheck="false" maxlength="255" placeholder="{{ctx.Locale.Tr "agent.chat_search_placeholder"}}">
						<i class="icon">{{svg "octicon-search"}}</i>
					</div>
				</form>
				<div class="ui attached segment agent-chat-list">
					{{/* the resident session is the entry to the global bot, so it always comes first */}}
					{{with .Sessions.Resident}}
						<a class="agent-chat-card agent-chat-card-resident{{if and $.Session (eq $.Session.ID .ID)}} active{{end}}" href="{{AppSubUrl}}/-/agent/{{.ID}}">
							<span class="agent-chat-card-icon">{{svg "gitea-pod-outline" 24}}</span>
							<span class="agent-chat-card-text">
								<span class="agent-chat-card-name">{{.Title}}</span>
								<span class="agent-chat-card-desc">{{ctx.Locale.Tr "agent.chat_resident_desc"}}</span>
							</span>
						</a>
					{{end}}

					<div class="agent-chat-divider"></div>

					<div class="agent-chat-group-title">
						{{svg "octicon-comment-discussion"}}
						<span>{{ctx.Locale.Tr "agent.chat_conversations"}}</span>
						{{if .SignedUser.IsAdmin}}
							<button type="button" class="btn agent-chat-group-action show-modal"
								data-modal="#agent-chat-folder-modal"
								data-modal-form.url="{{AppSubUrl}}/-/agent/folders/new"
								data-tooltip-content="{{ctx.Locale.Tr "agent.chat_folder_new"}}">
								{{svg "octicon-file-directory" 16}}<span class="agent-chat-group-action-plus">{{svg "octicon-plus" 10}}</span>
							</button>
						{{end}}
					</div>

					<a class="agent-chat-card agent-chat-card-new{{if .IsDraft}} active{{end}}" href="{{AppSubUrl}}/-/agent/new">
						<span class="agent-chat-card-main">
							<span class="agent-chat-card-name">{{ctx.Locale.Tr "agent.chat_new_conversation"}}</span>
						</span>
						<span class="agent-chat-card-icon">{{svg "octicon-plus" 16}}</span>
					</a>

					{{range .Sessions.Servers}}
						{{template "agent/chat_session_row" dict "Session" . "Selected" $.Session "FallbackIcon" "" "Folders" $.Sessions.Folders}}
					{{else}}
						{{if not .Sessions.Folders}}<p class="agent-chat-hint">{{ctx.Locale.Tr "agent.chat_no_conversations"}}</p>{{end}}
					{{end}}

					{{range .Sessions.Folders}}
						<div class="agent-chat-folder">
							<div class="agent-chat-card agent-chat-card-folder">
								<span class="agent-chat-card-main">
									<span class="agent-chat-card-icon">{{if .Folder.Icon}}{{svg .Folder.Icon 18}}{{else}}{{svg "octicon-file-directory" 18}}{{end}}</span>
									<span class="agent-chat-card-name gt-ellipsis">{{.Folder.Name}}</span>
								</span>
								<div class="ui dropdown jump agent-chat-more" data-tooltip-content="{{ctx.Locale.Tr "agent.chat_more"}}">
									{{svg "octicon-kebab-horizontal"}}
									<div class="menu">
										<div class="item agent-chat-more-item show-modal"
											data-modal="#agent-chat-folder-modal"
											data-modal-form.url="{{AppSubUrl}}/-/agent/folders/{{.Folder.ID}}"
											data-modal-name.value="{{.Folder.Name}}"
											data-icon="{{.Folder.Icon}}">{{ctx.Locale.Tr "agent.chat_folder_edit"}}</div>
										<div class="divider"></div>
										<div class="item agent-chat-more-item tw-text-red link-action"
											data-url="{{AppSubUrl}}/-/agent/folders/{{.Folder.ID}}/delete"
											data-modal-confirm-header="{{ctx.Locale.Tr "agent.chat_folder_delete"}}"
											data-modal-confirm-content="{{ctx.Locale.Tr "agent.chat_folder_delete_confirm" .Folder.Name}}">{{ctx.Locale.Tr "agent.delete"}}</div>
									</div>
								</div>
							</div>
							<div class="agent-chat-folder-items">
								{{range .Sessions}}
									{{template "agent/chat_session_row" dict "Session" . "Selected" $.Session "FallbackIcon" "" "Folders" $.Sessions.Folders}}
								{{end}}
							</div>
						</div>
					{{end}}
				</div>
			{{else}}
				<h4 class="ui top attached header tw-flex tw-items-center">
					<div class="tw-flex-1 tw-flex tw-items-center">
						{{ctx.Locale.Tr "agent.chat_repository"}}
						<span class="ui grey label tw-ml-2">{{index .ScopeCounts "repository"}}</span>
					</div>
				</h4>
				<form class="ui attached segment agent-chat-search" method="get" action="{{.ScopeBaseURL}}">
					<input type="hidden" name="scope" value="repository">
					<div class="ui small fluid left icon input">
						<input type="search" name="q" value="{{.Keyword}}" spellcheck="false" maxlength="255" placeholder="{{ctx.Locale.Tr "agent.chat_search_placeholder"}}">
						<i class="icon">{{svg "octicon-search"}}</i>
					</div>
				</form>
				<div class="ui attached segment agent-chat-list">
					{{if .WritableRepos}}
						<button type="button" class="agent-chat-card show-modal" data-modal="#agent-chat-repository-modal">
							<span class="agent-chat-card-main">
								<span class="agent-chat-card-icon">{{svg "octicon-plus" 18}}</span>
								<span class="agent-chat-card-name">{{ctx.Locale.Tr "agent.chat_new_conversation"}}</span>
							</span>
						</button>
					{{end}}
					{{range $index, $group := .Sessions.Repositories}}
						<div class="agent-chat-repo">
							{{if $index}}<div class="agent-chat-divider"></div>{{end}}
							<div class="agent-chat-group-title">
								{{svg "octicon-comment-discussion"}}
								<span>{{ctx.Locale.Tr "agent.chat_conversations"}}</span>
							</div>
							<a class="agent-chat-subtitle gt-ellipsis" href="{{$group.Repo.Link}}" title="{{$group.Repo.FullName}}">{{$group.Repo.FullName}}</a>
							{{range $group.Sessions}}
								{{template "agent/chat_session_row" dict "Session" . "Selected" $.Session "FallbackIcon" ""}}
							{{end}}
						</div>
					{{else}}
						<p class="agent-chat-hint">{{ctx.Locale.Tr "agent.chat_no_repository"}}</p>
					{{end}}
					<p class="agent-chat-hint">{{ctx.Locale.Tr "agent.chat_repository_help"}}</p>
				</div>

				{{if .WritableRepos}}
					<div class="ui modal" id="agent-chat-repository-modal">
						<div class="header">{{ctx.Locale.Tr "agent.chat_new_conversation"}}</div>
						<form class="ui form" method="get" action="{{AppSubUrl}}/-/agent/new">
							<div class="content">
								<div class="required field">
									<label for="repo_id">{{ctx.Locale.Tr "agent.chat_repository"}}</label>
									<select id="repo_id" name="repo_id" class="ui dropdown" required>
										{{range .WritableRepos}}
											<option value="{{.ID}}">{{.FullName}}</option>
										{{end}}
									</select>
								</div>
							</div>
							<div class="actions">
								<button class="ui cancel button" type="button">{{ctx.Locale.Tr "cancel"}}</button>
								<button class="ui primary button" type="submit">{{ctx.Locale.Tr "agent.chat_new_conversation"}}</button>
							</div>
						</form>
					</div>
				{{end}}
			{{end}}
		</div>
		<div class="flex-container-main agent-chat-main" aria-label="{{ctx.Locale.Tr "agent.chat_title"}}"
			{{if .Session}}data-conversation-id="{{.Session.ID}}"
			data-last-message-id="{{.LastMessageID}}"
			data-events-url="{{AppSubUrl}}/-/agent/{{.Session.ID}}/events"
			data-messages-url="{{AppSubUrl}}/-/agent/{{.Session.ID}}/messages"
			data-cancel-url="{{AppSubUrl}}/-/agent/{{.Session.ID}}/cancel"
			data-labels="{{.LabelsJSON}}"{{end}}>
			{{if .IsDraft}}
				<header class="agent-chat-head">
					<a class="agent-chat-back" href="{{AppSubUrl}}/-/agent" data-tooltip-content="{{ctx.Locale.Tr "agent.chat_sessions"}}">{{svg "octicon-chevron-left"}}</a>
					<div class="agent-chat-head-icon">{{svg "octicon-plus" 20}}</div>
					<div class="agent-chat-head-text">
						<div class="agent-chat-head-title gt-ellipsis">{{ctx.Locale.Tr "agent.chat_new_conversation"}}</div>
						{{if .Repo}}
							<div class="agent-chat-meta"><a href="{{.Repo.Link}}">{{.Repo.FullName}}</a></div>
						{{end}}
					</div>
				</header>

				<div class="agent-chat-messages">
					<div class="agent-chat-empty">{{ctx.Locale.Tr "agent.chat_draft_help"}}</div>
				</div>

				<form class="agent-chat-composer agent-chat-draft" method="post" enctype="multipart/form-data" action="{{AppSubUrl}}/-/agent/new" data-draft-url="{{AppSubUrl}}/-/agent/new">
					<input type="hidden" name="kind" value="{{.DraftKind}}">
					{{if .Repo}}<input type="hidden" name="repo_id" value="{{.Repo.ID}}">{{end}}
					<div class="agent-chat-draft-model">
						<select name="model_ref" class="ui dropdown" aria-label="{{ctx.Locale.Tr "agent.chat_model"}}" required>
							<option value="">{{ctx.Locale.Tr "agent.chat_model_none"}}</option>
							{{range .ModelOptions}}
								<option value="{{.Ref}}"{{if eq .Ref $.DraftModelRef}} selected{{end}}>{{.Label}}</option>
							{{end}}
						</select>
					</div>
					<textarea name="content" class="agent-chat-input" rows="3" required placeholder="{{ctx.Locale.Tr "agent.chat_placeholder"}}"></textarea>
					<label class="agent-chat-attach" data-tooltip-content="{{ctx.Locale.Tr "agent.chat_attach"}}">
						{{svg "octicon-paperclip" 16}}
						<input type="file" name="files" multiple>
					</label>
					<button type="submit" class="ui primary button">{{ctx.Locale.Tr "agent.chat_send"}}</button>
				</form>
			{{else if .Session}}
				<header class="agent-chat-head">
					<a class="agent-chat-back" href="{{AppSubUrl}}/-/agent" data-tooltip-content="{{ctx.Locale.Tr "agent.chat_sessions"}}">{{svg "octicon-chevron-left"}}</a>
					<div class="agent-chat-head-icon">
						{{if eq .Session.Kind "resident"}}{{svg "gitea-pod-outline" 20}}{{else if eq .Session.Kind "server"}}{{svg "octicon-server" 20}}{{else}}{{svg "octicon-repo" 20}}{{end}}
					</div>
					<div class="agent-chat-head-text">
						<div class="agent-chat-head-title gt-ellipsis">{{.Session.Title}}</div>
						{{if .Repo}}
							<div class="agent-chat-meta"><a href="{{.Repo.Link}}">{{.Repo.FullName}}</a></div>
						{{end}}
					</div>
					<form class="agent-chat-model" method="post" action="{{AppSubUrl}}/-/agent/{{.Session.ID}}/model">
						<select name="model_ref" class="ui dropdown" aria-label="{{ctx.Locale.Tr "agent.chat_model"}}">
							<option value="">{{ctx.Locale.Tr "agent.chat_model_none"}}</option>
							{{range .ModelOptions}}
								<option value="{{.Ref}}"{{if eq .Ref $.Session.ModelRef}} selected{{end}}>{{.Label}}</option>
							{{end}}
						</select>
						<button type="submit" class="ui mini button">{{ctx.Locale.Tr "agent.chat_model_apply"}}</button>
					</form>
					<a class="ui basic icon button" href="{{AppSubUrl}}/-/agent/{{.Session.ID}}/export" download="conversation.md"
						data-tooltip-content="{{ctx.Locale.Tr "agent.chat_download"}}">{{svg "octicon-download"}}</a>
					{{if ne .Session.Kind "resident"}}
						<form method="post" action="{{AppSubUrl}}/-/agent/{{.Session.ID}}/delete">
							<button type="submit" class="ui basic icon button" data-tooltip-content="{{ctx.Locale.Tr "agent.chat_delete"}}">{{svg "octicon-trash"}}</button>
						</form>
					{{end}}
				</header>

				<div class="agent-chat-status{{if not (or .RunActive (eq .Run.Status "failed") (eq .Run.Status "canceled"))}} tw-hidden{{end}}" data-status="{{if .Run}}{{.Run.Status}}{{end}}">
					<span class="agent-chat-status-text">{{.RunText}}</span>
					<button type="button" class="agent-chat-status-cancel agent-chat-row-action{{if not .RunActive}} tw-hidden{{end}}">{{ctx.Locale.Tr "agent.chat_cancel"}}</button>
				</div>

				<div class="agent-chat-messages">
					{{if .HasOlderMessages}}
						<button type="button" class="ui basic button agent-chat-load-older"
							data-messages-url="{{AppSubUrl}}/-/agent/{{.Session.ID}}/messages"
							data-oldest="{{.OldestMessageID}}">{{ctx.Locale.Tr "agent.chat_load_older"}}</button>
					{{end}}
					{{range .Messages}}
						<div class="agent-chat-message {{.Role}}" data-message-id="{{.ID}}">
							<div class="agent-chat-message-meta">
								{{if eq .Role "user"}}
									{{ctx.Locale.Tr "agent.chat_you"}}
								{{else if eq .Role "assistant"}}
									{{ctx.Locale.Tr "agent.chat_agent"}}
								{{else}}
									{{ctx.Locale.Tr "agent.chat_system"}}
								{{end}}
								· {{DateUtils.TimeSince .CreatedUnix}}
							</div>
							<div class="agent-chat-bubble">
								<div class="render-content markup">{{ctx.RenderUtils.MarkdownToHtml .Content}}</div>
								{{$attachments := index $.MessageAttachments .ID}}
								{{if $attachments}}
									<div class="agent-chat-attachments">
										{{range $attachments}}
											<a class="agent-chat-attachment" href="{{AppSubUrl}}{{.URL}}">
												{{svg "octicon-paperclip" 14}}
												<span class="gt-ellipsis">{{.Name}}</span>
												<span class="agent-chat-attachment-size">{{.SizeText}}</span>
											</a>
										{{end}}
									</div>
								{{end}}
							</div>
							<div class="agent-chat-message-actions">
								<button type="button" class="agent-chat-copy-message" data-tooltip-content="{{ctx.Locale.Tr "agent.chat_copy"}}">{{svg "octicon-copy" 14}}</button>
								{{if eq .Role "user"}}
									<button type="button" class="agent-chat-edit-message show-modal"
										data-modal="#agent-chat-edit-modal"
										data-modal-form.url="{{AppSubUrl}}/-/agent/{{$.Session.ID}}/messages/{{.ID}}"
										data-tooltip-content="{{ctx.Locale.Tr "agent.chat_edit"}}">{{svg "octicon-pencil" 14}}</button>
								{{end}}
							</div>
							<div class="agent-chat-source tw-hidden">{{.Content}}</div>
						</div>
					{{else}}
						<div class="agent-chat-empty">{{ctx.Locale.Tr "agent.chat_no_messages"}}</div>
					{{end}}
				</div>

				<form class="agent-chat-composer" method="post" enctype="multipart/form-data" action="{{AppSubUrl}}/-/agent/{{.Session.ID}}/messages">
					<textarea name="content" class="agent-chat-input" rows="3" required placeholder="{{ctx.Locale.Tr "agent.chat_placeholder"}}"{{if not .Session.ModelRef}} disabled{{end}}></textarea>
					<label class="agent-chat-attach" data-tooltip-content="{{ctx.Locale.Tr "agent.chat_attach"}}">
						{{svg "octicon-paperclip" 16}}
						<input type="file" name="files" multiple>
					</label>
					<button type="submit" class="ui primary button"{{if not .Session.ModelRef}} disabled{{end}}>{{ctx.Locale.Tr "agent.chat_send"}}</button>
				</form>
				{{if not .Session.ModelRef}}
					<p class="agent-chat-hint agent-chat-hint-block">{{ctx.Locale.Tr "agent.chat_model_required"}}</p>
				{{end}}
			{{else}}
				<div class="agent-chat-empty-main">
					{{svg "gitea-pod-outline" 56}}
					<p class="agent-chat-empty-title">{{ctx.Locale.Tr "agent.chat_select_session"}}</p>
					<p class="agent-chat-hint">{{ctx.Locale.Tr "agent.chat_select_session_help"}}</p>
				</div>
			{{end}}
		</div>
	</div>
	<div class="ui modal" id="agent-chat-title-modal">
		<div class="header">{{ctx.Locale.Tr "agent.chat_title_change"}}</div>
		<form class="ui form" method="post" id="agent-chat-title-form">
			<div class="content">
				<div class="required field">
					<label for="agent-chat-title-input">{{ctx.Locale.Tr "agent.chat_conversation_title"}}</label>
					<input id="agent-chat-title-input" name="title" maxlength="100" required>
				</div>
			</div>
			<div class="actions">
				<button class="ui cancel button" type="button">{{ctx.Locale.Tr "cancel"}}</button>
				<button class="ui primary button" type="submit">{{ctx.Locale.Tr "save"}}</button>
			</div>
		</form>
	</div>

	<div class="ui modal" id="agent-chat-edit-modal">
		<div class="header">{{ctx.Locale.Tr "agent.chat_edit"}}</div>
		<form class="ui form" method="post" id="agent-chat-edit-form">
			<div class="content">
				<div class="required field">
					<label for="agent-chat-edit-input">{{ctx.Locale.Tr "agent.chat_message"}}</label>
					<textarea id="agent-chat-edit-input" name="content" rows="6" required></textarea>
				</div>
				<p class="help">{{ctx.Locale.Tr "agent.chat_edit_confirm"}}</p>
			</div>
			<div class="actions">
				<button class="ui cancel button" type="button">{{ctx.Locale.Tr "cancel"}}</button>
				<button class="ui primary button" type="submit">{{ctx.Locale.Tr "agent.chat_edit"}}</button>
			</div>
		</form>
	</div>

	<div class="ui modal" id="agent-chat-folder-modal">
		<div class="header">{{ctx.Locale.Tr "agent.chat_folder"}}</div>
		<form class="ui form" method="post" id="agent-chat-folder-form">
			<div class="content">
				<div class="required field">
					<label for="agent-chat-folder-name">{{ctx.Locale.Tr "agent.chat_folder_name"}}</label>
					<input id="agent-chat-folder-name" name="name" maxlength="100" required>
				</div>
				<div class="field">
					<label>{{ctx.Locale.Tr "agent.chat_icon"}}</label>
					<div class="agent-chat-icon-picker">
						<label class="agent-chat-icon-option">
							<input type="radio" name="icon" value="">
							<span class="agent-chat-icon-none">{{ctx.Locale.Tr "agent.chat_icon_none"}}</span>
						</label>
						{{range .ConversationIcons}}
							<label class="agent-chat-icon-option" data-tooltip-content="{{.}}">
								<input type="radio" name="icon" value="{{.}}">
								{{svg . 20}}
							</label>
						{{end}}
					</div>
				</div>
			</div>
			<div class="actions">
				<button class="ui cancel button" type="button">{{ctx.Locale.Tr "cancel"}}</button>
				<button class="ui primary button" type="submit">{{ctx.Locale.Tr "save"}}</button>
			</div>
		</form>
	</div>

	<div class="ui modal" id="agent-chat-folder-pick-modal">
		<div class="header">{{ctx.Locale.Tr "agent.chat_folder_move"}}</div>
		<form class="ui form" method="post" id="agent-chat-folder-pick-form">
			<div class="content">
				<div class="required field">
					<label for="agent-chat-folder-pick">{{ctx.Locale.Tr "agent.chat_folder"}}</label>
					<select id="agent-chat-folder-pick" name="folder_id" class="ui dropdown" required>
						<option value="">{{ctx.Locale.Tr "agent.chat_folder_none"}}</option>
						{{range .Sessions.Folders}}
							<option value="{{.Folder.ID}}">{{.Folder.Name}}</option>
						{{end}}
					</select>
				</div>
			</div>
			<div class="actions">
				<button class="ui cancel button" type="button">{{ctx.Locale.Tr "cancel"}}</button>
				<button class="ui primary button" type="submit">{{ctx.Locale.Tr "save"}}</button>
			</div>
		</form>
	</div>
</div>
{{template "base/footer" .}}
