{{template "admin/layout_head" (dict "pageClass" "admin agent")}}
	<div class="admin-setting-content">
		<h4 class="ui top attached header">
			{{ctx.Locale.Tr "agent.tools_title"}}
		</h4>
		<div class="ui attached segment">
			<p class="help">{{ctx.Locale.Tr "agent.tools_help"}}</p>
			{{if .Rows}}
				<form class="ui form" method="post" action="{{AppSubUrl}}/-/admin/agent/tools">
					<table class="ui very basic table unstackable">
						<thead>
							<tr>
								<th>{{ctx.Locale.Tr "agent.tools_name"}}</th>
								<th>{{ctx.Locale.Tr "agent.tools_scope"}}</th>
								<th>{{ctx.Locale.Tr "agent.tools_mode"}}</th>
								<th>{{ctx.Locale.Tr "agent.tools_enabled"}}</th>
							</tr>
						</thead>
						<tbody>
							{{range .Rows}}
								{{$row := .}}
								<tr>
									<td>
										<code>{{.Name}}</code>
										<div class="muted">{{.Description}}</div>
									</td>
									<td class="tw-whitespace-nowrap">
										{{if eq .Scope "server"}}
											{{ctx.Locale.Tr "agent.tools_scope_server"}}
										{{else if eq .Scope "repository"}}
											{{ctx.Locale.Tr "agent.tools_scope_repository"}}
										{{else}}
											{{ctx.Locale.Tr "agent.tools_scope_user"}}
										{{end}}
									</td>
									<td>
										<select id="agent-tool-mode-{{.Name}}" name="mode_{{.Name}}" class="ui dropdown">
											<option value="llm"{{if eq $row.Mode "llm"}} selected{{end}}>{{ctx.Locale.Tr "agent.tools_mode_llm"}}</option>
											<option value="manual"{{if eq $row.Mode "manual"}} selected{{end}}>{{ctx.Locale.Tr "agent.tools_mode_manual"}}</option>
											<option value="allow_all"{{if eq $row.Mode "allow_all"}} selected{{end}}>{{ctx.Locale.Tr "agent.tools_mode_allow_all"}}</option>
										</select>
									</td>
									<td>
										<div class="ui checkbox">
											<input id="agent-tool-enabled-{{.Name}}" name="enabled_{{.Name}}" type="checkbox" value="true" aria-label="{{ctx.Locale.Tr "agent.tools_enabled"}}"{{if .Enabled}} checked{{end}}>
											<label></label>
										</div>
									</td>
								</tr>
							{{end}}
						</tbody>
					</table>
					<button class="ui primary button" type="submit">{{ctx.Locale.Tr "save"}}</button>
				</form>
			{{else}}
				<p class="tw-text-center">{{ctx.Locale.Tr "agent.tools_none"}}</p>
			{{end}}
		</div>
	</div>
{{template "admin/layout_footer" .}}
