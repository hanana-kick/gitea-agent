{{template "admin/layout_head" (dict "pageClass" "admin new agent")}}
	<div class="admin-setting-content">
		<h4 class="ui top attached header">
			{{if .IsEdit}}{{ctx.Locale.Tr "agent.edit_provider"}}{{else}}{{ctx.Locale.Tr "agent.add_provider"}}{{end}}
		</h4>
		<div class="ui attached segment">
			{{if .ErrorMsg}}
				<div class="ui error message">{{.ErrorMsg}}</div>
			{{end}}
			{{if .Notice}}
				<div class="ui positive message">{{.Notice}}</div>
			{{end}}
			{{/* field order: name, template, base URL, key source, models, custom headers */}}
			<form class="ui form" id="provider-new-form" action="{{.FormAction}}" method="post">
				{{if .IsEdit}}<input type="hidden" name="provider_id" value="{{.Provider.ID}}">{{end}}
				<div class="required field">
					<label for="name">{{ctx.Locale.Tr "agent.provider_name"}}</label>
					<input id="name" type="text" name="name" value="{{.Form.Name}}" placeholder="{{ctx.Locale.TrString "agent.provider_name_placeholder"}}" autofocus required maxlength="255">
				</div>

				<div class="required field">
					<label for="provider">{{ctx.Locale.Tr "agent.provider_template"}}</label>
					<select class="ui selection dropdown" id="provider" name="provider" required>
						{{range .ProviderTypes}}
							<option value="{{.Type}}" data-base-url="{{.DefaultBaseURL}}" data-requires-base-url="{{.RequiresBaseURL}}" {{if eq .Type $.Form.Provider}}selected{{end}}>{{ctx.Locale.Tr (printf "agent.provider_%s" .Type)}}</option>
						{{end}}
					</select>
				</div>

				<div class="required field" id="field-base-url">
					<label for="base_url">{{ctx.Locale.Tr "agent.base_url"}}</label>
					<input id="base_url" type="text" name="base_url" value="{{.Form.BaseURL}}" placeholder="{{ctx.Locale.TrString "agent.base_url_placeholder"}}" maxlength="255">
					<p class="help" id="base-url-help">{{ctx.Locale.Tr "agent.base_url_help"}}</p>
				</div>
				<div class="field tw-hidden" id="field-base-url-fixed">
					<label>{{ctx.Locale.Tr "agent.base_url"}}</label>
					<div class="tw-flex tw-items-center tw-gap-2">
						<code id="base-url-fixed"></code>
						<span class="ui basic small label">{{ctx.Locale.Tr "agent.fixed"}}</span>
					</div>
					<p class="help">{{ctx.Locale.Tr "agent.base_url_fixed_help"}}</p>
				</div>

				<div class="required field">
					<label for="api_key_id">{{ctx.Locale.Tr "agent.api_key"}}</label>
					<select id="api_key_id" name="api_key_id" class="ui dropdown">
						<option value="">{{ctx.Locale.Tr "agent.api_key_none"}}</option>
						{{range .APIKeys}}
							<option value="{{.ID}}"{{if eq .ID $.Form.APIKeyID}} selected{{end}}>{{.Name}}</option>
						{{end}}
					</select>
					<p class="help">
						{{ctx.Locale.Tr "agent.api_key_select_help"}}
						<a href="{{AppSubUrl}}/-/admin/agent/keys">{{ctx.Locale.Tr "agent.api_key_manage"}}</a>
					</p>
				</div>

				<div class="required field">
					<label>{{ctx.Locale.Tr "agent.models"}}</label>
					<input type="hidden" name="model_catalog" value="{{.CatalogEncoded}}">
					{{/* toolbar: filter on the left, fetch action on the right */}}
					<div class="flex-text-block tw-my-2">
						<div class="tw-flex-1">
							{{if .Catalog}}
								<input type="search" id="model-filter" placeholder="{{ctx.Locale.TrString "agent.models_filter_placeholder"}}" autocomplete="off" aria-label="{{ctx.Locale.Tr "agent.models_filter"}}">
							{{end}}
						</div>
						<button type="submit" class="ui button" formaction="{{.FetchAction}}" formnovalidate>{{ctx.Locale.Tr "agent.models_fetch"}}</button>
					</div>
					{{if .Catalog}}
						{{/* no height utilities exist in the tw- set, so keep these two inline */}}
						<div id="model-list" class="tw-flex tw-flex-col tw-gap-1 tw-overflow-auto tw-border tw-border-secondary tw-rounded tw-p-2 tw-mb-2" style="min-height: 6rem; max-height: 15rem">
							{{range .Catalog}}
								<div class="ui checkbox" data-model="{{.DisplayName}} {{.ID}}">
									<input type="checkbox" name="models" value="{{.ID}}" {{if $.Form.HasSelected .ID}}checked{{end}}>
									<label>
										<strong>{{.DisplayName}}</strong>
										{{if ne .Name .ID}}<span class="tw-text-text-light tw-ml-2">{{.ID}}</span>{{end}}
										{{template "agent/model_inputs" .Inputs}}
									</label>
								</div>
							{{end}}
							<div class="tw-hidden tw-text-text-light" id="model-list-empty">{{ctx.Locale.Tr "agent.models_no_match"}}</div>
						</div>
					{{end}}
					{{/* nested so the required marker of the models field does not apply */}}
					<div class="tw-mt-2">
						<label for="manual_models">{{ctx.Locale.Tr "agent.models_manual"}}</label>
						<textarea id="manual_models" name="manual_models" rows="3" placeholder="{{ctx.Locale.TrString "agent.models_manual_placeholder"}}">{{.Form.ManualRaw}}</textarea>
						<p class="help">{{ctx.Locale.Tr "agent.models_help"}}</p>
					</div>
				</div>

				<div class="field">
					<label for="headers">{{ctx.Locale.Tr "agent.headers"}}</label>
					<textarea id="headers" name="headers" rows="3" placeholder="{{ctx.Locale.TrString "agent.headers_placeholder"}}">{{.Form.HeadersRaw}}</textarea>
					<p class="help">{{ctx.Locale.Tr "agent.headers_help"}}</p>
				</div>

				<div class="field">
					<button type="submit" class="ui primary button">
						{{if .IsEdit}}{{ctx.Locale.Tr "save"}}{{else}}{{ctx.Locale.Tr "agent.add_provider"}}{{end}}
					</button>
					<a class="ui button" href="{{.CancelLink}}">{{ctx.Locale.Tr "cancel"}}</a>
				</div>
			</form>
		</div>

		<h4 class="ui top attached header">
			{{ctx.Locale.Tr "agent.provider_defaults"}}
		</h4>
		<div class="ui attached table segment">
			<table class="ui very basic table unstackable">
				<thead>
					<tr>
						<th>{{ctx.Locale.Tr "agent.provider_template"}}</th>
						<th>{{ctx.Locale.Tr "agent.base_url"}}</th>
						<th>{{ctx.Locale.Tr "agent.fixed_headers"}}</th>
					</tr>
				</thead>
				<tbody>
					{{range .ProviderTypes}}
						<tr>
							<td>{{ctx.Locale.Tr (printf "agent.provider_%s" .Type)}}</td>
							<td>
								{{if .RequiresBaseURL}}{{ctx.Locale.Tr "agent.base_url_user_supplied"}}{{else}}{{.DefaultBaseURL}}{{end}}
							</td>
							<td>{{range $i, $h := .FixedHeaders}}{{if $i}}, {{end}}{{$h}}{{else}}—{{end}}</td>
						</tr>
					{{end}}
				</tbody>
			</table>
		</div>
	</div>

	<script nonce="{{ctx.CspScriptNonce}}">
		(() => {
			const form = document.getElementById("provider-new-form");
			if (!form) return;

			// the template decides whether the base URL is typed in or fixed
			const syncBaseURL = () => {
				const opt = form.querySelector("#provider").selectedOptions[0];
				const requires = opt?.dataset.requiresBaseUrl === "true";
				document.getElementById("field-base-url").classList.toggle("tw-hidden", !requires);
				document.getElementById("base_url").required = requires;
				document.getElementById("field-base-url-fixed").classList.toggle("tw-hidden", requires);
				document.getElementById("base-url-fixed").textContent = opt?.dataset.baseUrl || "";
			};

			// filter the fetched models as the user types
			const filterEl = form.querySelector("#model-filter");
			const listEl = form.querySelector("#model-list");
			const emptyEl = form.querySelector("#model-list-empty");
			const syncModels = () => {
				if (!listEl) return;
				const query = filterEl.value.trim().toLowerCase();
				let shown = 0;
				for (const row of listEl.querySelectorAll("[data-model]")) {
					const match = !query || row.dataset.model.toLowerCase().includes(query);
					row.classList.toggle("tw-hidden", !match);
					if (match) shown++;
				}
				emptyEl.classList.toggle("tw-hidden", shown > 0);
			};

			form.querySelector("#provider").addEventListener("change", syncBaseURL);
			filterEl?.addEventListener("input", syncModels);
			syncBaseURL();
			syncModels();
		})();
	</script>
{{template "admin/layout_footer" .}}
