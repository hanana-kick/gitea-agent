{{template "admin/layout_head" (dict "pageClass" "admin agent")}}
	<div class="admin-setting-content">
		<h4 class="ui top attached header">
			{{ctx.Locale.Tr "agent.mcp_title"}} ({{ctx.Locale.Tr "admin.total" .Total}})
			<div class="ui right">
				<a class="ui primary tiny button" href="{{AppSubUrl}}/-/admin/agent/mcp/new">{{ctx.Locale.Tr "agent.mcp_add"}}</a>
			</div>
		</h4>
		<div class="ui attached segment">
			<form class="ui form ignore-dirty flex-text-block">
				<div class="tw-flex-1">
					{{template "shared/search/combo" dict "Value" .Keyword "Placeholder" (ctx.Locale.Tr "agent.mcp_search_placeholder")}}
				</div>
			</form>
		</div>
		<div class="ui attached table segment">
			<table class="ui very basic selectable table unstackable">
				<thead>
					<tr>
						<th>{{ctx.Locale.Tr "agent.name"}}</th>
						<th>{{ctx.Locale.Tr "agent.mcp_url"}}</th>
						<th>{{ctx.Locale.Tr "agent.mcp_tools"}}</th>
						<th>{{ctx.Locale.Tr "agent.mcp_read_only"}}</th>
						<th>{{ctx.Locale.Tr "agent.enabled"}}</th>
						<th>{{ctx.Locale.Tr "admin.users.created"}}</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					{{range .Servers}}
						<tr>
							<td class="tw-whitespace-nowrap">
								{{.Name}}
								<div class="tw-text-light tw-text-12">{{.Description}}</div>
							</td>
							<td class="gt-ellipsis tw-max-w-64">{{.URL}}</td>
							<td class="tw-whitespace-nowrap"><code>{{.ToolPrefix}}…</code></td>
							<td>{{if .ReadOnly}}{{svg "octicon-check"}}{{end}}</td>
							<td>{{if .Enabled}}{{svg "octicon-check"}}{{end}}</td>
							<td class="tw-whitespace-nowrap">{{.Created}}</td>
							<td>
								<div class="tw-flex tw-gap-2">
									<a href="{{AppSubUrl}}/-/admin/agent/mcp/{{.ID}}/edit" data-tooltip-content="{{ctx.Locale.Tr "agent.edit"}}">{{svg "octicon-pencil"}}</a>
									<button type="button" class="btn interact-fg link-action"
										data-url="{{AppSubUrl}}/-/admin/agent/mcp/{{.ID}}/test"
										data-modal-confirm-header="{{ctx.Locale.Tr "agent.mcp_test"}}"
										data-modal-confirm-content="{{ctx.Locale.Tr "agent.mcp_test_confirm" .Name}}"
										data-tooltip-content="{{ctx.Locale.Tr "agent.mcp_test"}}"
									>{{svg "octicon-sync"}}</button>
									<button type="button" class="btn interact-fg tw-text-red link-action"
										data-url="{{AppSubUrl}}/-/admin/agent/mcp/{{.ID}}/delete"
										data-modal-confirm-header="{{ctx.Locale.Tr "agent.delete"}}"
										data-modal-confirm-content="{{ctx.Locale.Tr "agent.mcp_delete_confirm" .Name}}"
										data-tooltip-content="{{ctx.Locale.Tr "agent.delete"}}"
									>{{svg "octicon-trash"}}</button>
								</div>
							</td>
						</tr>
					{{else}}
						<tr><td class="tw-text-center" colspan="7">{{ctx.Locale.Tr "no_results_found"}}</td></tr>
					{{end}}
				</tbody>
			</table>
		</div>
		{{template "base/paginate" .}}
	</div>
{{template "admin/layout_footer" .}}
