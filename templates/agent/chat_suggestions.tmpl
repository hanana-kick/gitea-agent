{{if .Suggestions}}
	<div class="agent-chat-suggestions">
		<div class="agent-chat-suggestions-chips">
			{{range .Suggestions}}
				<button type="button" class="agent-chat-suggestion" data-prompt="{{.Prompt}}"
					{{if .Title}}data-tooltip-content="{{.Title}}"{{end}}>
					{{svg .Icon 14}}
					<span>{{ctx.Locale.Tr (printf "agent.suggest_%s" .Key)}}</span>
				</button>
			{{end}}
		</div>
	</div>
{{end}}
