{{- $session := .Session -}}
{{- $selected := .Selected -}}
{{- $fallbackIcon := .FallbackIcon -}}
{{- $folders := .Folders -}}
<div class="agent-chat-card{{if and $selected (eq $selected.ID $session.ID)}} active{{end}}" data-session-id="{{$session.ID}}">
	<a class="agent-chat-card-main" href="{{AppSubUrl}}/-/agent/{{$session.ID}}">
		{{/* no empty icon slot: without an icon the title lines up with the other cards */}}
		{{if $session.Icon}}
			<span class="agent-chat-card-icon">{{svg $session.Icon 18}}</span>
		{{else if $fallbackIcon}}
			<span class="agent-chat-card-icon">{{svg $fallbackIcon 18}}</span>
		{{end}}
		<span class="agent-chat-card-text">
			<span class="agent-chat-card-name gt-ellipsis">{{$session.Title}}</span>
			{{if .Subtitle}}<span class="agent-chat-card-desc gt-ellipsis">{{.Subtitle}}</span>{{end}}
		</span>
		{{if .Busy}}<span class="agent-chat-card-busy" data-tooltip-content="{{ctx.Locale.Tr "agent.chat_busy"}}"><i></i><i></i><i></i></span>{{end}}
	</a>
	<button type="button" class="agent-chat-more" data-tooltip-content="{{ctx.Locale.Tr "agent.chat_more"}}" aria-haspopup="true">
		{{svg "octicon-kebab-horizontal"}}
	</button>
	<div class="agent-chat-more-menu" popover="auto" role="menu">
		<div class="item agent-chat-more-item show-modal"
			data-modal="#agent-chat-title-modal"
			data-modal-form.url="{{AppSubUrl}}/-/agent/{{$session.ID}}/title"
			data-modal-title.value="{{$session.Title}}">{{ctx.Locale.Tr "agent.chat_title_change"}}</div>
		{{if $folders}}
			<div class="item agent-chat-more-item show-modal"
				data-modal="#agent-chat-folder-pick-modal"
				data-modal-form.url="{{AppSubUrl}}/-/agent/{{$session.ID}}/folder"
				data-folder="{{$session.FolderID}}">{{ctx.Locale.Tr "agent.chat_folder_move"}}</div>
		{{end}}
		<div class="divider"></div>
		<div class="item agent-chat-more-item tw-text-red link-action"
			data-url="{{AppSubUrl}}/-/agent/{{$session.ID}}/delete"
			data-modal-confirm-header="{{ctx.Locale.Tr "agent.chat_delete"}}"
			data-modal-confirm-content="{{ctx.Locale.Tr "agent.chat_delete_confirm" $session.Title}}">{{ctx.Locale.Tr "agent.delete"}}</div>
	</div>
</div>
